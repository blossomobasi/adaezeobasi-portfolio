# EmailJS (https://www.emailjs.com) - used by the contact form
# Template variables: {{user_name}}, {{user_email}}, {{inquiry_type}}, {{subject}}, {{message}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public URL of the deployed site (used for sitemap/metadata)
NEXT_PUBLIC_SITE_URL=https://adaezeobasi.vercel.app
